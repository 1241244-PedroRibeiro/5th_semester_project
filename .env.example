# ==============================================================================
# LaPrizza - Environment Configuration Template (.env.example)
# Aligned with docs/asist/sys-deployment.md and SYS01 Acceptance Criteria.
# Do NOT store real secrets here. Provide values locally in .env (ignored by git).
# ==============================================================================

# Node / Execution Environment
PORT=3000
NODE_ENV=production

# Database (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_USER=laprizza_user
DB_PASSWORD=
DB_NAME=laprizza_db
DB_SCHEMA=public
DB_POOL_MAX=20
DB_SSL=false
DB_LOGGING=false
SEED_DATABASE=true

# Security & Authentication
JWT_SECRET=
JWT_EXPIRATION=86400
INVITATION_TTL_HOURS=48
SESSION_INACTIVITY_MINUTES=15

# OIDC (OpenID Connect / Google IdP)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_SESSION_COOKIE_SECRET=

# External Services & Dependencies
PROLOG_URL=http://prolog:8080/api/v1/plan
FRONTEND_URL=https://localhost
KITCHEN_ASSET_BASE_URL=http://frontend:8080

# SMTP / Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Network / TLS
# Deployment-specific VPN source pools. Validate each pool from the VM logs
# before enabling it; do not use 10.0.0.0/8 as an access allowlist.
ALLOWED_SOURCE_CIDRS=10.8.0.0/16
TLS_CERT_PATH=/etc/nginx/certs/site.crt
TLS_KEY_PATH=/etc/nginx/certs/site.key

# Shared Resource Folder (SYS04)
# Defaults to ./shared for local dev and CI; set to /var/lib/laprizza/shared on production Linux host
LAPRIZZA_SHARED_DIR=./shared
