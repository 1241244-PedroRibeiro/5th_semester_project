PORT=3000
NODE_ENV=development

# Empty for direct connections. Behind a proxy, list only its actual IPs/CIDRs.
# Docker Compose sets this to the fixed Nginx container address.
TRUSTED_PROXY_CIDRS=

# Database configuration: set DATABASE_URL or all DB_HOST/DB_USER/DB_PASSWORD/DB_NAME values.
# DATABASE_URL=postgresql://user:password@localhost:5432/laprizza_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=laprizza_user
DB_PASSWORD=laprizza_password
DB_NAME=laprizza_db
DB_SCHEMA=public
DB_POOL_MAX=20
DB_SSL=false
DB_LOGGING=false

# JWT Security
JWT_SECRET=super_secret_development_key_change_in_production_2026
JWT_EXPIRATION=86400

# Password recovery SMTP. Set SMTP_PASSWORD locally; never commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=laprizzag05@gmail.com
SMTP_PASSWORD=

# OIDC
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/external/callback
OIDC_SCOPES=openid email profile
OIDC_SESSION_COOKIE_SECRET=super_secret_cookie_key_change_me
FRONTEND_URL=http://localhost:4200

PROLOG_URL=http://localhost:8080/api/v1/plan