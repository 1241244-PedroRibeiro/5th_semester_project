{
  "name": "laprizza-backend",
  "version": "1.0.0",
  "description": "LaPrizza Back-End REST API Modular Monolith Container",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run migration:run:prod",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/infrastructure/persistence/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/persistence/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/infrastructure/persistence/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/infrastructure/persistence/data-source.ts",
    "seed": "ts-node src/bootstrap/seed/run-seed.ts",
    "migration:run:prod": "typeorm migration:run -d dist/infrastructure/persistence/data-source.js",
    "seed:prod": "node dist/bootstrap/seed/run-seed.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "migration:baseline": "ts-node src/infrastructure/persistence/run-baseline.ts",
    "migration:baseline:prod": "node dist/infrastructure/persistence/run-baseline.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.3.10",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/typeorm": "^10.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "openid-client": "^5.7.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^10.3.10",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.16.2",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20"
  }
}
