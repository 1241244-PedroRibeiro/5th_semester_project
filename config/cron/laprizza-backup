# laprizza SYS08 - Backup cron jobs
# Daily full DB dump at 02:00 UTC
# Weekly full at 03:00 UTC Sunday
# Monthly full at 04:00 UTC first day of month
# Off-site sync (NAS + S3) at 05:00 UTC daily
# WAL archiving continuous (handled by PostgreSQL config)

# Environment variables for backup scripts
BACKUP_DIR=/backups
DB_NAME=laprizza_db
DB_USER=laprizza_user
DB_HOST=postgres
DB_PORT=5432
AGE_PUBKEY_FILE=/etc/laprizza/age.pub
AGE_PRIVKEY_FILE=/etc/laprizza/age.key
NAS_HOST=nas.dei.example.com
NAS_USER=laprizza-backup
NAS_PATH=/backups/laprizza
NAS_SSH_KEY=/etc/laprizza/nas_ssh_key
S3_REMOTE=laprizza-s3
S3_BUCKET=laprizza-backups
S3_PATH=laprizza/
AGE_PUBKEY_S3=/etc/laprizza/age-s3.pub
RCLONE_CONFIG=/etc/rclone.conf

# Daily backup at 02:00 UTC
0 2 * * * root /usr/local/sbin/backup.sh daily >> /backups/backup-cron.log 2>&1

# Weekly backup at 03:00 UTC Sunday
0 3 * * 0 root /usr/local/sbin/backup.sh weekly >> /backups/backup-cron.log 2>&1

# Monthly backup at 04:00 UTC first day of month
0 4 1 * * root /usr/local/sbin/backup.sh monthly >> /backups/backup-cron.log 2>&1

# Off-site sync to NAS at 05:00 UTC daily
0 5 * * * root /usr/local/sbin/backup-to-nas.sh >> /backups/backup-cron.log 2>&1

# Off-site sync to S3 at 05:30 UTC daily
30 5 * * * root /usr/local/sbin/backup-to-s3.sh >> /backups/backup-cron.log 2>&1

# Weekly restore test at 06:00 UTC Sunday
0 6 * * 0 root /usr/local/sbin/restore-test.sh >> /backups/restore-test.log 2>&1

# Monthly DR drill at 07:00 UTC first Sunday
0 7 1-7 * 0 root /usr/local/sbin/dr-drill.sh >> /backups/dr-drill.log 2>&1