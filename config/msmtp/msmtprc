# laprizza SYS05 - msmtp configuration for SSH alert emails
# Uses local MTA (Postfix/Exim) or remote SMTP relay

# Gmail SMTP account. Store the app password only on the VM.
account default
host smtp.gmail.com
port 587
from laprizzag05@gmail.com
user laprizzag05@gmail.com
passwordeval "cat /etc/laprizza/msmtp-app-password"
tls on
tls_starttls on
auth on
logfile /var/log/msmtp.log