#%PAM-1.0
# laprizza SYS05 - PAM configuration for SSH
# Order: time check -> conditional MFA -> authentication -> session audit

auth      required   pam_env.so
auth      [success=1 default=ignore] pam_exec.so quiet /usr/local/sbin/laprizza-ssh-failure-hook pre
auth      required   pam_google_authenticator.so

account   required   pam_time.so
account   required   pam_unix.so
account   required   pam_faillock.so

password  required   pam_unix.so sha512 shadow nullok

session   required   pam_limits.so
session   required   pam_unix.so
session   optional   pam_exec.so quiet /usr/local/sbin/laprizza-ssh-audit-start
session   optional   pam_exec.so quiet /usr/local/sbin/laprizza-ssh-audit-end