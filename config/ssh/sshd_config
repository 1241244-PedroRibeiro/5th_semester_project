# laprizza SYS05 - SSH daemon configuration
# Port 2222 (non-standard), key-only authentication, individual admin accounts

Port 2222
Protocol 2

# HostKey files (default locations)
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Logging
SyslogFacility AUTH
LogLevel INFO

# Authentication
LoginGraceTime 60
PermitRootLogin prohibit-password
StrictModes yes
MaxAuthTries 3
MaxSessions 10

# Key-only authentication
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
ChallengeResponseAuthentication yes
KbdInteractiveAuthentication yes
UsePAM yes

# Allow only individually identifiable admin accounts
AllowUsers root laprizza-admin-eduardo laprizza-admin-pedro laprizza-admin-mota laprizza-admin-gustavo

# Conditional MFA rules are generated by laprizza-ssh-failure-monitor.

# Security
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitTunnel no
PermitUserEnvironment no
DebianBanner no

# Session
ClientAliveInterval 300
ClientAliveCountMax 2
MaxStartups 10:30:60

# SFTP subsystem
Subsystem sftp /usr/lib/openssh/sftp-server

# Banner
Banner /etc/ssh/banner.net

# Conditional per-user/source MFA rules are loaded after global settings.
Include /etc/ssh/sshd_config.d/*.conf

Match User root
    AuthenticationMethods publickey