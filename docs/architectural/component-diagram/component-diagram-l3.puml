@startuml component-diagram-l3
!pragma layout smetana
skinparam packageStyle rectangle
skinparam componentStyle uml2
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 55

skinparam component {
  BackgroundColor #F8F9FA
  BorderColor #2B2D42
  ArrowColor #1D3557
  FontName "Arial"
  FontSize 11
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1D3557
}
skinparam database {
  BackgroundColor #D8F3DC
  BorderColor #2B2D42
}

title LaPrizza Back-End — Component Diagram (C4 Level 3, Sprint 2 Baseline)

' ============================== EXTERNAL CLIENTS & SYSTEMS ==============================
package "External Clients & Sibling Containers" <<Cloud>> {
  [SPA — Angular] as SPA #E2EAFC
  [3D Canvas — Three.js] as ThreeJS #E2EAFC
  [Prolog AI Planning Engine] as PrologEngine #EDE9FE
  [External Identity Provider (OIDC)] as IdP #FFF4E6
  [SMTP / Email Provider] as EmailProvider #FFF4E6
}

package "Back-End Modular Monolith" {

  ' ============================================================
  ' 1. PRESENTATION LAYER (HTTP Adapters)
  ' ============================================================
  package "1. Presentation & Delivery Layer" {

    package "Auth & Identity" {
      [AuthController\n«S1» local login] as C_Auth
      [ExternalAuthController\n«S2» OIDC login/callback] as C_ExtAuth
      [ActivationController\n«S2» invitation/activation] as C_Activation
      [UserController / BackofficeUsersController\n«S1» users & roles] as C_Users
    }

    package "Business Modules" {
      [CustomerController\n«S1»] as C_Customer
      [CategoryController\n«S1»] as C_Category
      [AllergenController\n«S1»] as C_Allergen
      [ProductController\n«S1»] as C_Product
      [PizzaSizeController\n«S1»] as C_Size
      [PizzaComponentTypeController\n«S1»] as C_Type
      [ComponentSizeConfigurationController\n«S1»] as C_SizeCfg
      [StockController\n«S1»] as C_Stock
      [PredefinedPizzaController\n«S1»] as C_Pizza
      [CatalogueController\n«S1»] as C_Catalogue
    }

    package "Sprint 2" {
      [KitchenConfigurationController\n«S2» WEB06] as C_Kitchen
      [ConsumptionForecastController\n«S2» WEB07] as C_Forecast
      [SupplierScenarioController\n«S2» WEB07] as C_Supplier
      [PlanningController\n«S2» AI05] as C_Planning
      [ProductExportController\n«S2» WEB07] as C_Export
    }
  }

  ' ============================================================
  ' 2. APPLICATION SERVICES LAYER
  ' ============================================================
  package "2. Application Services Layer" {

    package "Identity & Access" {
      [AuthService\n«S1» JWT + Argon2id] as S_Auth
      [ExternalAuthService\n«S2» OIDC flow + JIT provisioning] as S_ExtAuth
      [ActivationInvitationService\n«S2» invitations + email dispatch] as S_Invitation
      [UserService\n«S1» users & roles] as S_Users
      [RoleAuditService\n«S2» RoleChangeLog writes] as S_RoleAudit
    }

    package "Sprint 1 Business" {
      [CustomerService «S1»] as S_Customer
      [CategoryService «S1»] as S_Category
      [AllergenService «S1»] as S_Allergen
      [ProductService «S1»] as S_Product
      [PizzaSizeService «S1»] as S_Size
      [PizzaComponentTypeService «S1»] as S_Type
      [ComponentSizeConfigurationService «S1»] as S_SizeCfg
      [StockService «S1»] as S_Stock
      [PredefinedPizzaService «S1»] as S_Pizza
      [CatalogueQueryService «S1» BCK11] as S_Catalogue
    }

    package "Sprint 2 AI Planning & Kitchen" {
      [KitchenConfigurationService\n«S2» validate + activate] as S_Kitchen
      [ConsumptionForecastService\n«S2» CRUD + validation] as S_Forecast
      [SupplierScenarioService\n«S2» import + confirm] as S_Supplier
      [PlanningService\n«S2» BOM + RequirementsPlanning\norchestration] as S_Planning
      [ProductExportService\n«S2» product→JSON export] as S_Export
    }
  }

  ' ============================================================
  ' 3. DOMAIN CORE LAYER
  ' ============================================================
  package "3. Domain Core Layer" {

    package "Sprint 1 Aggregates" {
      [User\n+ ActivationInvitation «S2»] as D_User
      [Customer] as D_Customer
      [ProductCategory] as D_Category
      [Allergen] as D_Allergen
      [Product] as D_Product
      [PizzaSize] as D_Size
      [PizzaComponentType] as D_Type
      [ComponentSizeConfiguration] as D_SizeCfg
      [StockItem] as D_Stock
      [PredefinedPizza] as D_Pizza
    }

    package "Sprint 2 Aggregates" {
      [KitchenConfiguration] as D_Kitchen
      [ConsumptionForecast] as D_Forecast
      [SupplierScenario] as D_Supplier
      [PlanningResult] as D_Planning
      [RoleChangeLog] as D_RoleAudit
    }

    package "Domain Services" {
      [PricingDomainService «S1»] as DS_Pricing
      [StockAvailabilityDomainService «S1»] as DS_Avail
      [KitchenConfigValidationService «S2»\n(JSON schema + asset refs)] as DS_KitchenValidation
      [PlanningSnapshotDomainService «S2»\n(deep-copies inputs for read-only replay)] as DS_Snapshot
    }
  }

  ' ============================================================
  ' 4. INFRASTRUCTURE LAYER (Repositories + External Adapters)
  ' ============================================================
  package "4. Infrastructure & Persistence Layer" {

    package "Repository Interfaces (Ports)" {
      interface "IUserRepository «S1»" as IR_User
      interface "ICustomerRepository «S1»" as IR_Customer
      interface "ICategoryRepository «S1»" as IR_Category
      interface "IAllergenRepository «S1»" as IR_Allergen
      interface "IProductRepository «S1»" as IR_Product
      interface "IPizzaSizeRepository «S1»" as IR_Size
      interface "IPizzaComponentTypeRepository «S1»" as IR_Type
      interface "IComponentSizeConfigurationRepository «S1»" as IR_SizeCfg
      interface "IStockRepository «S1»" as IR_Stock
      interface "IPredefinedPizzaRepository «S1»" as IR_Pizza
      interface "ICatalogueRepository «S1»" as IR_Catalogue
      interface "IKitchenConfigurationRepository «S2»" as IR_Kitchen
      interface "IConsumptionForecastRepository «S2»" as IR_Forecast
      interface "ISupplierScenarioRepository «S2»" as IR_Supplier
      interface "IPlanningResultRepository «S2»" as IR_Planning
      interface "IActivationInvitationRepository «S2»" as IR_Invitation
      interface "IRoleChangeLogRepository «S2»" as IR_RoleAudit
    }

    package "PostgreSQL Adapters" {
      [PostgresUserRepository] as R_User
      [PostgresCustomerRepository] as R_Customer
      [PostgresCategoryRepository] as R_Category
      [PostgresAllergenRepository] as R_Allergen
      [PostgresProductRepository] as R_Product
      [PostgresPizzaSizeRepository] as R_Size
      [PostgresPizzaComponentTypeRepository] as R_Type
      [PostgresComponentSizeConfigurationRepository] as R_SizeCfg
      [PostgresStockRepository] as R_Stock
      [PostgresPredefinedPizzaRepository] as R_Pizza
      [PostgresCatalogueRepository] as R_Catalogue
      [PostgresKitchenConfigurationRepository «S2»] as R_Kitchen
      [PostgresConsumptionForecastRepository «S2»] as R_Forecast
      [PostgresSupplierScenarioRepository «S2»] as R_Supplier
      [PostgresPlanningResultRepository «S2»] as R_Planning
      [PostgresActivationInvitationRepository «S2»] as R_Invitation
      [PostgresRoleChangeLogRepository «S2»] as R_RoleAudit
    }

    package "External Adapters (Ports & Adapters)" {
      [Argon2Hasher «S1»] as I_Argon
      [JwtTokenService «S1»] as I_Jwt
      [OidcClient «S2»\n(openid-client library)] as I_Oidc
      [PrologHttpClient «S2»\n(HTTP fetch to Prolog container)] as I_Prolog
      [SmtpEmailAdapter «S2»] as I_Email
    }
  }
}

' ============================================================
' EXTERNAL INTERFACES (REST endpoints, called by clients)
' ============================================================
() "/api/v1/auth" as API_Auth
() "/api/v1/auth/external" as API_ExtAuth
() "/api/v1/auth/activate" as API_Activation
() "/api/v1/users" as API_Users
