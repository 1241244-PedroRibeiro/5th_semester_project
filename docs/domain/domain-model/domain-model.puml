' AI PLANNING  (uses business keys; #30 #36 refinements)
' =====================================================================
package "AI PLANNING" #F3E5F5 {

  package "Consumption Forecast Aggregate" #FFFFFF {
    class ConsumptionForecast <<Root>> {
      name : ForecastName «id»
      startDate : Date
      endDate : Date
      entries : List<ForecastEntry>
      createdAt : Timestamp
      updatedAt : Timestamp
      --
      addEntry(Date, Sku, PizzaSizeName, int)
      removeEntry(ForecastEntryId)
      validateAgainstReferences(Set<Sku>, Set<PizzaSizeName>)
    }
    note right of ConsumptionForecast
      Covers ALL sellable products:
      pizzas (with pizza_size) AND non-pizza
      products (pizza_size = null).
      Pizzas → BOM expansion; non-pizza →
      stockUnitsPerSale per unit sold.
      (Clarification #36)
    end note
    class ForecastEntry <<Entity>> {
      entryId : Long «id»
      date : Date
      productSku : Sku
      pizzaSize : PizzaSizeName [0..1]
      quantity : int
    }
  }

  package "Supplier Scenario Aggregate" #FFFFFF {
    class SupplierScenario <<Root>> {
      name : ScenarioName «id»
      suppliers : List<Supplier>
      offers : List<SupplierOffer>
      isSimulated : boolean
      confirmedAt : Timestamp [0..1]
      createdAt : Timestamp
      --
      addSupplier(Supplier)
      addOffer(SupplierOffer)
      confirm()
    }
    class Supplier <<Entity>> {
      supplierCode : SupplierCode «id»
      name : String [0..1]
    }
    class SupplierOffer <<Entity>> {
      supplierCode : SupplierCode
      productSku : Sku
      priceEUR : Money
      stockUnitQuantity : int
      leadTimeDays : int
      dailySupplyLimit : int [0..1]
    }
    note right of SupplierOffer
      stockUnitQuantity is an INDIVISIBLE
      purchase lot. The plan rounds the
      required qty UP to a multiple of it.
      dailySupplyLimit is per-offer per-day,
      not shared across products of the supplier.
      (Clarifications #28 follow-up, #30)
    end note
  }

  package "Planning Result Aggregate" #FFFFFF {
    class PlanningResult <<Root>> {
      executionId : Long «id»
      forecastName : ForecastName
      scenarioName : ScenarioName
      forecastSnapshot : ForecastSnapshot
      supplierScenarioSnapshot : SupplierScenarioSnapshot
      stockSnapshot : StockSnapshot
      bomReference : String
      referenceDate : Date
      isReplay : boolean
      isSimulated : boolean
      executedAt : Timestamp
      requirements : List<DailyRequirement>
      proposals : List<PurchaseProposal>
      unmetNeeds : List<UnmetNeed>
    }
    class ForecastSnapshot <<VO>> {
      forecastName : ForecastName
      capturedEntries : List<ForecastEntry>
    }
    class SupplierScenarioSnapshot <<VO>> {
      scenarioName : ScenarioName
      capturedOffers : List<SupplierOffer>
    }
    class StockSnapshot <<VO>> {
      capturedAt : Timestamp
      quantities : Map<Sku, Integer>
    }
    class DailyRequirement <<VO>> {
      date : Date
      productSku : Sku
      requiredQuantity : int
    }
    class PurchaseProposal <<VO>> {
      productSku : Sku
      supplierCode : SupplierCode
      quantity : int
      orderDate : Date
      deliveryDate : Date
      priceEUR : Money
      meetsRequiredDate : boolean
      lateByDays : int
    }
    note right of PurchaseProposal
      quantity is a multiple of the
      SupplierOffer.stockUnitQuantity
      (indivisible lot).
      lateByDays = 0 ⇔ meetsRequiredDate.
      A late proposal does NOT satisfy the
      original unmet need.
      (Clarification #30)
    end note
    class UnmetNeed <<VO>> {
      date : Date
      productSku : Sku
      shortfall : int
      reason : String
    }
  }
}

