package "IDENTITY & CUSTOMERS" #EAF2FB {

  package "Authentication Session Aggregate" #FFFFFF {
    class AuthSession <<Root>> {
      id : UUID «id»
      username : Username
      lastActivityAt : Timestamp
      expiresAt : Timestamp
      revokedAt : Timestamp [0..1]
      --
      isActive(Date) : boolean
      isActiveFor(String, Date) : boolean
      recordActivity(Date)
      revoke(Date)
    }
    note right of AuthSession
      Session lifetime is inactivity-based
      (SESSION_INACTIVITY_MINUTES).
      Access-token lifetime is JWT_EXPIRES_IN.
      Logout revokes ONLY this session;
      other sessions of the same account
      remain valid.
      (Clarifications #29, #34)
    end note
  }

  package "User Aggregate" #FFFFFF {
    class User <<Root>> {
      username : Username «id»
      name : PersonName
      email : Email
      passwordHash : PasswordHash [0..1]
      externalIdpSubject : String [0..1]
      status : UserStatus
      roles : Set<RoleName>
      dietaryRestrictions : Set<DietaryRestriction>
      invitations : List<ActivationInvitation>
      createdAt : Timestamp
      updatedAt : Timestamp
      --
      changePassword(PasswordHash)
      activate() / deactivate()
      assignRole(RoleName) / revokeRole(RoleName)
      hasRole(RoleName) : boolean
      recordDietaryRestriction(AllergenName)
      clearDietaryRestriction(AllergenName)
      issueInvitation(InvitationPurpose) : String
      consumeInvitation(String) : Result
    }
    note right of User
      Login identifier = email, case-insensitive.
      Password recovery uses single-use link
      with configurable TTL; same password
      policy applies to create / change / recover.
      PENDING_REGISTRATION blocks login and
      exposes a resend-activation action.
      (Clarification #32)
    end note
    class PasswordHash <<VO>> {
      hashedValue : String
    }
    class RoleName <<VO>> {
      name : String
    }
    class Address <<VO>> {
      street : String
      postalCode : String
      city : String
      extraDetails : String
    }
    class PhoneNumber <<VO>> {
      value : String
    }
    class DietaryRestriction <<VO>> {
      allergenName : AllergenName
      recordedAt : Timestamp
    }
    class ActivationInvitation <<Entity>> {
      token : InvitationToken «id»
      purpose : InvitationPurpose
      expiresAt : Timestamp
      usedAt : Timestamp [0..1]
      revokedAt : Timestamp [0..1]
      createdAt : Timestamp
    }
    enum UserStatus <<Enum>> {
      ACTIVE
      DEACTIVATED
      PENDING_REGISTRATION
    }
    enum InvitationPurpose <<Enum>> {
      LOCAL_ACCOUNT_ACTIVATION
      EXTERNAL_IDP_MATCH
      PASSWORD_RESET
    }
  }

