#!/bin/bash
set -euo pipefail

state_file="/var/lib/laprizza/ssh-failures.json"
alert_log="/var/log/laprizza/ssh-alerts.log"
alert_to="laprizzag05@gmail.com"
override_file="/etc/ssh/sshd_config.d/99-laprizza-mfa.conf"
mkdir -p "$(dirname "$state_file")" "$(dirname "$alert_log")"
touch "$state_file" "$alert_log"
chown root:laprizza "$state_file" "$alert_log"
chmod 0640 "$state_file" "$alert_log"

update_state() {
    local action="$1" user="$2" source_ip="$3"
    python3 - "$state_file" "$action" "$user" "$source_ip" "$alert_log" "$alert_to" "$override_file" <<'PY'
import json
import grp
import os
import socket
import subprocess
import sys
import tempfile
import time

path, action, user, source_ip, alert_log, alert_to, override_file = sys.argv[1:]
now = int(time.time())
try:
    with open(path, encoding="utf-8") as handle:
        state = json.load(handle)
except (FileNotFoundError, json.JSONDecodeError):
    state = {}

state = {
    key: value for key, value in state.items()
    if now - int(value.get("last_failure", 0)) <= 86400
}
key = f"{user}|{source_ip}"
entry = state.get(key, {})

if action == "success":
    state.pop(key, None)
elif action == "failure":
    count = int(entry.get("failure_count", 0)) + 1
    last_alert = int(entry.get("last_alert", 0))
    entry = {
        "user": user,
        "source_ip": source_ip,
        "failure_count": count,
        "last_failure": now,
        "last_alert": last_alert,
        "mfa_required": True,
    }
    if count >= 4 and now - last_alert >= 3600:
        timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now))
        message = (
            f"From: ssh-alert@laprizza.local\n"
            f"To: {alert_to}\n"
            f"Subject: [ALERT] SSH failures for {user} from {source_ip}\n"
            f"\nTimestamp: {timestamp}\nUser: {user}\nSource IP: {source_ip}\n"
            f"Fail count: {count}\nLast attempt: {timestamp}\n"
            f"Hostname: {socket.gethostname()}\n"
        ).encode()
        alert_status = "failed"
        try:
            subprocess.run(
                ["msmtp", "-a", "default", alert_to],
                input=message,
                check=True,
                timeout=10,
            )
            alert_status = "sent"
        except (OSError, subprocess.SubprocessError):
            pass
        with open(alert_log, "a", encoding="utf-8") as handle:
            json.dump({
                "timestamp": timestamp,
                "hostname": socket.gethostname(),
                "user": user,
                "source_ip": source_ip,
                "failure_count": count,
                "alert": alert_status,
            }, handle)
            handle.write("\n")
        entry["last_alert"] = now
    state[key] = entry

lines = [
    "# Generated by laprizza-ssh-failure-monitor; do not edit.",
]
for item in state.values():
    if item.get("mfa_required") and item.get("user") and item.get("source_ip"):
        lines.extend([
            f"Match User {item['user']} Address {item['source_ip']}",
            "    AuthenticationMethods publickey,keyboard-interactive:pam",
            "",
        ])
os.makedirs(os.path.dirname(override_file), exist_ok=True)
previous = None
try:
    with open(override_file, "rb") as handle:
        previous = handle.read()
except FileNotFoundError:
    pass
desired = None if len(lines) == 1 else ("\n".join(lines) + "\n").encode()
if desired == previous:
    desired = previous
elif desired is None and previous is None:
    desired = previous
elif desired is None:
    os.unlink(override_file)
    subprocess.run(["systemctl", "reload", "ssh"], check=True)
    previous = None
if desired is not None and desired != previous:
    fd, override_temporary = tempfile.mkstemp(
        dir=os.path.dirname(override_file), prefix=".99-laprizza-mfa."
    )
    with os.fdopen(fd, "wb") as handle:
        handle.write(desired)
    os.replace(override_temporary, override_file)
    os.chmod(override_file, 0o644)
    validation = subprocess.run(
        ["sshd", "-t", "-f", "/etc/ssh/sshd_config"],
        capture_output=True,
        text=True,
    )
    if validation.returncode:
        if previous is None:
            os.unlink(override_file)
        else:
            with open(override_file, "wb") as handle:
                handle.write(previous)
        raise SystemExit(validation.stderr)
    subprocess.run(["systemctl", "reload", "ssh"], check=True)

directory = os.path.dirname(path)
fd, temporary = tempfile.mkstemp(dir=directory)
with os.fdopen(fd, "w", encoding="utf-8") as handle:
    json.dump(state, handle, indent=2)
    handle.write("\n")
os.replace(temporary, path)
os.chown(path, 0, grp.getgrnam("laprizza").gr_gid)
os.chmod(path, 0o640)
PY
}

update_state reconcile "" ""

journalctl -n 0 -f -o cat _COMM=sshd | while IFS= read -r line; do
    if [[ "$line" =~ Failed\ (publickey|password)\ for\ ([^[:space:]]+)\ from\ ([^[:space:]]+) ]]; then
        update_state failure "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    elif [[ "$line" =~ Invalid\ user\ ([^[:space:]]+)\ from\ ([^[:space:]]+) ]]; then
        update_state failure "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    elif [[ "$line" =~ PAM:\ Permission\ denied\ for\ ([^[:space:]]+)\ from\ ([^[:space:]]+) ]]; then
        update_state failure "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    elif [[ "$line" =~ Connection\ reset\ by\ authenticating\ user\ ([^[:space:]]+)\ ([^[:space:]]+)\ port ]]; then
        update_state failure "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    elif [[ "$line" =~ Accepted\ keyboard-interactive/pam\ for\ ([^[:space:]]+)\ from\ ([^[:space:]]+) ]]; then
        update_state success "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    fi
done
